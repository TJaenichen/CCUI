<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!--
        Design tokens. Accent, focus border and window tint are replaced at startup from appsettings.json
        (Appearance section, see Hosting/ThemeResources.cs); everything else is tuned here.
    -->
    <Color x:Key="AccentColor">#D97757</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#D97757" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#40D97757" />
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#D97757" />
    <Thickness x:Key="FocusBorderThickness">2</Thickness>
    <SolidColorBrush x:Key="WindowTintBrush" Color="#B0101014" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECECEC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6A6A6" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6E6E6E" />

    <SolidColorBrush x:Key="PanelBrush" Color="#38000000" />
    <SolidColorBrush x:Key="PanelStrongBrush" Color="#70000000" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#48000000" />
    <SolidColorBrush x:Key="HoverBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="PressedBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="InputBrush" Color="#50000000" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#48FFFFFF" />

    <!-- Session states -->
    <SolidColorBrush x:Key="WorkingBrush" Color="#61AFEF" />
    <SolidColorBrush x:Key="WaitingBrush" Color="#98C379" />
    <SolidColorBrush x:Key="IdleBrush" Color="#7F848E" />
    <SolidColorBrush x:Key="ExitedBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="AttentionBrush" Color="#E5C07B" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#E06C75" />
    <SolidColorBrush x:Key="AgentBrush" Color="#C678DD" />

    <!-- Activity meters: green → amber → red, like a VU meter. -->
    <LinearGradientBrush x:Key="MeterBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#98C379" />
        <GradientStop Offset="0.65" Color="#E5C07B" />
        <GradientStop Offset="1" Color="#E06C75" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="MeterTrackBrush" Color="#1EFFFFFF" />
    <SolidColorBrush x:Key="MeterPeakBrush" Color="#F0FFFFFF" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- Icon glyphs (Segoe Fluent Icons / MDL2 Assets) -->
    <sys:String x:Key="IconAdd">&#xE710;</sys:String>
    <sys:String x:Key="IconClose">&#xE8BB;</sys:String>
    <sys:String x:Key="IconRefresh">&#xE72C;</sys:String>
    <sys:String x:Key="IconMenu">&#xE700;</sys:String>
    <sys:String x:Key="IconDetails">&#xE8A5;</sys:String>
    <sys:String x:Key="IconSearch">&#xE721;</sys:String>
    <sys:String x:Key="IconClock">&#xE823;</sys:String>
    <sys:String x:Key="IconStopwatch">&#xE916;</sys:String>
    <sys:String x:Key="IconUp">&#xE74A;</sys:String>
    <sys:String x:Key="IconDown">&#xE74B;</sys:String>
    <sys:String x:Key="IconBell">&#xEA8F;</sys:String>
    <sys:String x:Key="IconInfo">&#xE946;</sys:String>
    <sys:String x:Key="IconError">&#xE783;</sys:String>
    <sys:String x:Key="IconMessage">&#xE8BD;</sys:String>
    <sys:String x:Key="IconPerson">&#xE77B;</sys:String>
    <sys:String x:Key="IconBulb">&#xE82F;</sys:String>
    <sys:String x:Key="IconTool">&#xE90F;</sys:String>
    <sys:String x:Key="IconRobot">&#xE99A;</sys:String>
    <sys:String x:Key="IconFolder">&#xE8B7;</sys:String>
    <sys:String x:Key="IconRestore">&#xE777;</sys:String>
    <sys:String x:Key="IconCopy">&#xE8C8;</sys:String>
</ResourceDictionary>
