<Window x:Class="CCUI.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:reskeys="clr-namespace:AvalonDock.Themes.VS2013.Themes;assembly=AvalonDock.Themes.VS2013"
        xmlns:vm="clr-namespace:CCUI.Core.ViewModels;assembly=CCUI.Core"
        xmlns:claude="clr-namespace:CCUI.Core.Claude;assembly=CCUI.Core"
        xmlns:views="clr-namespace:CCUI.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ShellViewModel}"
        Title="CCUI" Width="1500" Height="940" MinWidth="640" MinHeight="400"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}" FontSize="12.5"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <!-- Glass frame everywhere: DWM draws the backdrop and the caption buttons; WPF draws the rest. -->
        <WindowChrome CaptionHeight="38" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="True" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Let the backdrop show through the docking area. -->
        <Style x:Key="DocumentHeaderDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Fill" Value="{StaticResource IdleBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Content.Activity}" Value="{x:Static claude:SessionActivity.Working}">
                    <Setter Property="Fill" Value="{StaticResource WorkingBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Content.Activity}" Value="{x:Static claude:SessionActivity.WaitingForUser}">
                    <Setter Property="Fill" Value="{StaticResource WaitingBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Content.NeedsAttention}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource AttentionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Content.HasExited}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource ExitedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- Tint over the acrylic/mica backdrop. The caption buttons' corner stays clear: DWM draws the buttons
             underneath the window content, so anything painted there would hide them. -->
        <Grid IsHitTestVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Rectangle Fill="{DynamicResource WindowTintBrush}" Margin="0,0,140,0" />
            <Rectangle Grid.Row="1" Fill="{DynamicResource WindowTintBrush}" />
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Title bar. The right 150px stay free for the window's caption buttons. -->
            <DockPanel Grid.ColumnSpan="3" Margin="8,0,150,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource IconToggleStyle}" WindowChrome.IsHitTestVisibleInChrome="True"
                                  Content="{StaticResource IconMenu}" IsChecked="{Binding IsSessionListVisible}" ToolTip="Session list (Ctrl+Shift+B)" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="13"
                               Foreground="{DynamicResource AccentBrush}" Text="▐▛█▜▌" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="CCUI" />
                    <Border Style="{StaticResource ChipStyle}" Margin="10,0,0,0" Background="{DynamicResource AccentSoftBrush}"
                            Visibility="{Binding IsDemo, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontSize="11" Foreground="{DynamicResource AccentBrush}" Text="demo" />
                    </Border>
                    <Button Margin="14,0,0,0" Style="{StaticResource IconButtonStyle}" WindowChrome.IsHitTestVisibleInChrome="True"
                            Content="{StaticResource IconAdd}" Command="{Binding NewSessionCommand}" ToolTip="New session (Ctrl+Shift+T)" />
                    <Button Style="{StaticResource IconButtonStyle}" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnTileClick"
                            ToolTip="Tile all sessions (Ctrl+Shift+G)">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE80A;" />
                    </Button>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding StatusText}" />
                <Border />
            </DockPanel>

            <!-- Session list, resizable with the grip on its right edge. -->
            <views:SessionListView x:Name="SessionList" Grid.Row="1" Grid.Column="0" Width="{Binding SessionListWidth}"
                                   Visibility="{Binding IsSessionListVisible, Converter={StaticResource BoolToVisibility}}" />
            <Thumb Grid.Row="1" Grid.Column="1" Width="6" Cursor="SizeWE" DragDelta="OnSessionListResize"
                   Visibility="{Binding IsSessionListVisible, Converter={StaticResource BoolToVisibility}}">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <avalonDock:DockingManager x:Name="Dock" Grid.Row="1" Grid.Column="2" Margin="0,0,6,4"
                                       DocumentsSource="{Binding Panes}"
                                       ActiveContent="{Binding ActivePane, Mode=TwoWay}"
                                       Background="Transparent"
                                       AllowMixedOrientation="True">
                <avalonDock:DockingManager.Resources>
                    <!-- Overrides of the VS2013 dark theme: transparent wells so the backdrop shows, accent-coloured active tab. -->
                    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.Background}" Color="Transparent" />
                    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.TabBackground}" Color="Transparent" />
                    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.PanelBorderBrush}" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DocumentWellTabSelectedActiveBackground}" Color="{DynamicResource AccentColor}" />
                    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DocumentWellTabSelectedActiveText}" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DocumentWellTabSelectedInactiveBackground}" Color="#40FFFFFF" />
                    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DocumentWellTabSelectedInactiveText}" Color="#FFE6E6E6" />
                    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DocumentWellTabUnselectedBackground}" Color="Transparent" />
                    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DocumentWellTabUnselectedText}" Color="#FFA6A6A6" />
                    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DocumentWellTabUnselectedHoveredBackground}" Color="#20FFFFFF" />
                </avalonDock:DockingManager.Resources>
                <avalonDock:DockingManager.Theme>
                    <avalonDock:Vs2013DarkTheme />
                </avalonDock:DockingManager.Theme>

                <avalonDock:DockingManager.LayoutItemContainerStyle>
                    <Style TargetType="{x:Type avalonDock:LayoutItem}">
                        <Setter Property="Title" Value="{Binding Model.Title}" />
                        <Setter Property="ToolTip" Value="{Binding Model.WorkingDirectory}" />
                        <Setter Property="ContentId" Value="{Binding Model.ContentId}" />
                        <Setter Property="CloseCommand" Value="{Binding Model.CloseCommand}" />
                    </Style>
                </avalonDock:DockingManager.LayoutItemContainerStyle>

                <avalonDock:DockingManager.LayoutItemTemplate>
                    <DataTemplate>
                        <views:SessionPaneView />
                    </DataTemplate>
                </avalonDock:DockingManager.LayoutItemTemplate>

                <avalonDock:DockingManager.DocumentHeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource DocumentHeaderDot}" />
                            <TextBlock Text="{Binding Title}" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </avalonDock:DockingManager.DocumentHeaderTemplate>

                <avalonDock:LayoutRoot>
                    <avalonDock:LayoutPanel Orientation="Horizontal">
                        <avalonDock:LayoutDocumentPane />
                    </avalonDock:LayoutPanel>
                </avalonDock:LayoutRoot>
            </avalonDock:DockingManager>

            <!-- Status bar with the main shortcuts. -->
            <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="12,0">
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                           Text="Alt+Arrows move focus · Ctrl+Shift+D details · Ctrl+Shift+T new · Ctrl+Shift+G tile · Ctrl+Shift+B list" />
                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding ActivePane.WorkingDirectory, Mode=OneWay}" /><Run Text="{Binding ActivePane.SessionId, Mode=OneWay, StringFormat='  ·  {0}'}" />
                </TextBlock>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
