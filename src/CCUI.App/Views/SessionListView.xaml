<UserControl x:Class="CCUI.App.Views.SessionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CCUI.Core.ViewModels;assembly=CCUI.Core"
             xmlns:claude="clr-namespace:CCUI.Core.Claude;assembly=CCUI.Core"
             xmlns:controls="clr-namespace:CCUI.App.Controls"
             Foreground="{StaticResource TextPrimaryBrush}"
             FontFamily="{StaticResource UiFont}"
             FontSize="12.5"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ShellViewModel}"
             d:DesignHeight="700" d:DesignWidth="320">
    <UserControl.Resources>
        <!-- State dot: open sessions show live state; closed ones a hollow ring. -->
        <Style x:Key="ListDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Margin" Value="0,5,8,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="StrokeThickness" Value="1.2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource IdleBrush}" />
                    <Setter Property="Stroke" Value="{x:Null}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Pane.Activity}" Value="{x:Static claude:SessionActivity.Working}">
                    <Setter Property="Fill" Value="{StaticResource WorkingBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Pane.Activity}" Value="{x:Static claude:SessionActivity.WaitingForUser}">
                    <Setter Property="Fill" Value="{StaticResource WaitingBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Pane.NeedsAttention}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource AttentionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Pane.HasExited}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource ExitedBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Pane.Activity}" Value="{x:Static claude:SessionActivity.Working}" />
                        <Condition Binding="{Binding Pane.HasExited}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Stands in for the state dot while Claude works, in the state colours (blue; amber when it needs you). -->
        <Style x:Key="ListSpinnerStyle" TargetType="controls:OrbitSpinner">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Fill" Value="{StaticResource WorkingBrush}" />
            <Setter Property="IsSpinning" Value="{DynamicResource AnimationsEnabled}" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Pane.Activity}" Value="{x:Static claude:SessionActivity.Working}" />
                        <Condition Binding="{Binding Pane.HasExited}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Pane.NeedsAttention}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource AttentionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Menu items that make no sense on the implicit "Other" folder. -->
        <Style x:Key="FolderOnlyItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOther}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FolderOnlySeparator" TargetType="Separator" BasedOn="{StaticResource {x:Static MenuItem.SeparatorStyleKey}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOther}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A folder: chevron, name, counts, and a vault mark when a vault folder applies. The row's Tag carries the
             list view model so the context menu, which lives outside the visual tree, can reach its commands. -->
        <HierarchicalDataTemplate DataType="{x:Type vm:FolderViewModel}" ItemsSource="{Binding Children}">
            <Grid Background="Transparent" ToolTip="{Binding ToolTip}" Margin="-2,0,0,0"
                  Tag="{Binding DataContext.SessionList, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="New session here" Style="{StaticResource FolderOnlyItem}"
                                  Command="{Binding PlacementTarget.Tag.NewSessionInCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                        <MenuItem Header="New subfolder" Style="{StaticResource FolderOnlyItem}"
                                  Command="{Binding PlacementTarget.Tag.NewFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                        <MenuItem Header="New folder"
                                  Command="{Binding PlacementTarget.Tag.NewFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOther}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <Separator Style="{StaticResource FolderOnlySeparator}" />
                        <MenuItem Header="Rename…" Style="{StaticResource FolderOnlyItem}"
                                  Command="{Binding PlacementTarget.Tag.RenameFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                        <MenuItem Header="Delete folder" Style="{StaticResource FolderOnlyItem}"
                                  Command="{Binding PlacementTarget.Tag.DeleteFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                        <Separator Style="{StaticResource FolderOnlySeparator}" />
                        <MenuItem Header="Set working directory…" Style="{StaticResource FolderOnlyItem}" ToolTip="New sessions here start in it; unplaced sessions found under it show here."
                                  Command="{Binding PlacementTarget.Tag.SetFolderDirectoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                        <MenuItem Header="Clear working directory" Style="{StaticResource FolderOnlyItem}" IsEnabled="{Binding HasWorkingDirectory}"
                                  Command="{Binding PlacementTarget.Tag.ClearFolderDirectoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                        <Separator Style="{StaticResource FolderOnlySeparator}" />
                        <MenuItem Header="Set vault folder…" Style="{StaticResource FolderOnlyItem}" ToolTip="An Obsidian vault, or a folder inside one, for this folder and everything below it."
                                  Command="{Binding PlacementTarget.Tag.SetVaultFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                        <MenuItem Header="Clear vault folder" Style="{StaticResource FolderOnlyItem}" IsEnabled="{Binding HasOwnVaultFolder}"
                                  Command="{Binding PlacementTarget.Tag.ClearVaultFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                        <MenuItem Header="Open vault folder" Style="{StaticResource FolderOnlyItem}" IsEnabled="{Binding HasVaultFolder}"
                                  Command="{Binding PlacementTarget.Tag.OpenVaultFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton Width="16" Height="16" Margin="0,0,2,0" Focusable="False" Cursor="Hand"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Mode=TwoWay}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent">
                                <TextBlock x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="9"
                                           Foreground="{StaticResource TextMutedBrush}" Text="&#xE76C;" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE70D;" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <TextBlock Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Text="{StaticResource IconFolder}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="6,0,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="{Binding SessionCount}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,2,0">
                    <Border Style="{StaticResource ChipStyle}" Background="#3361AFEF" ToolTip="Working"
                            Visibility="{Binding WorkingCount, Converter={StaticResource VisibleWhen}}">
                        <TextBlock FontSize="10" Foreground="{StaticResource WorkingBrush}" Text="{Binding WorkingCount}" />
                    </Border>
                    <Border Style="{StaticResource ChipStyle}" Background="#33E5C07B" ToolTip="Needs you"
                            Visibility="{Binding AttentionCount, Converter={StaticResource VisibleWhen}}">
                        <TextBlock FontSize="10" Foreground="{StaticResource AttentionBrush}" Text="{Binding AttentionCount}" />
                    </Border>
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Text="&#xE8F1;" ToolTip="{Binding EffectiveVaultFolder}"
                               Visibility="{Binding HasVaultFolder, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:SessionListItemViewModel}" ItemsSource="{Binding Agents}">
            <!-- A double click opens the session; with SessionList:OpenOnClick a single click does (see code-behind). -->
            <Grid ToolTip="{Binding ToolTip}" Background="Transparent" MouseLeftButtonUp="OnItemMouseUp" ContextMenuOpening="OnSessionMenuOpening"
                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick"
                                  Command="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                </Grid.InputBindings>
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open" FontWeight="SemiBold"
                                  Command="{Binding PlacementTarget.Tag.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                        <MenuItem Command="{Binding PlacementTarget.Tag.SessionList.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header" Value="Pin to top" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="Header" Value="Unpin" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <!-- Filled in by the code-behind with the folders of the moment. -->
                        <MenuItem Header="Move to" Tag="move">
                            <MenuItem Header="(no folders)" IsEnabled="False" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Open folder in Explorer"
                                  Command="{Binding PlacementTarget.Tag.SessionList.OpenSessionFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                        <MenuItem Header="Copy session id"
                                  Command="{Binding PlacementTarget.Tag.SessionList.CopySessionIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="13" Height="13" Margin="-2,3,6,0" VerticalAlignment="Top">
                    <Ellipse Style="{StaticResource ListDotStyle}" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <controls:OrbitSpinner Style="{StaticResource ListSpinnerStyle}" />
                </Grid>
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,2,5,0" Foreground="{DynamicResource AccentBrush}" Text="&#xE718;"
                                   ToolTip="Pinned" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Project}" />
                        <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="{Binding Branch, StringFormat=' · ⎇ {0}', TargetNullValue=''}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <WrapPanel Margin="-4,3,0,0">
                        <Border Style="{StaticResource ChipStyle}" Background="#33E5C07B" ToolTip="Killed by the last reboot. Double-click to reopen it."
                                Visibility="{Binding KilledAtReboot, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="10" Foreground="{StaticResource AttentionBrush}" Text="reboot" />
                                <Button Margin="5,0,0,0" Style="{StaticResource TextButtonStyle}" ToolTip="Dismiss"
                                        Command="{Binding DataContext.DismissKilledSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock FontSize="10" Foreground="{StaticResource AttentionBrush}" Text="✕" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ChipStyle}" ToolTip="Running in another window"
                                Visibility="{Binding RunningElsewhere, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Text="running elsewhere" />
                        </Border>
                        <Border Style="{StaticResource ChipStyle}" Background="#33E5C07B" ToolTip="{Binding Pane.AttentionMessage}"
                                Visibility="{Binding Pane.NeedsAttention, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}">
                            <TextBlock FontSize="10" Foreground="{StaticResource AttentionBrush}" Text="needs you" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
                <TextBlock Grid.Column="2" Margin="8,1,2,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="{Binding LastActiveText}" />
            </Grid>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type vm:AgentViewModel}">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding Description}">
                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="11" Foreground="{StaticResource AgentBrush}" Text="{StaticResource IconRobot}" />
                <TextBlock Margin="6,0,0,0" FontSize="11.5" Foreground="{StaticResource AgentBrush}" Text="{Binding AgentType}" />
                <TextBlock Margin="6,0,0,0" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Margin="6,3,0,6">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="12,10,8,6">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="{StaticResource IconAdd}"
                        Command="{Binding NewSessionCommand}" ToolTip="New session (Ctrl+Shift+T)" />
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Command="{Binding SessionList.NewFolderCommand}" ToolTip="New folder">
                    <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE8F4;" />
                </Button>
                <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="SESSIONS" />
                <TextBlock VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="{Binding SessionList.Items.Count}" />
            </DockPanel>

            <TextBox x:Name="Filter" DockPanel.Dock="Top" Margin="10,0,10,6" Style="{StaticResource SearchBoxStyle}" Tag="Filter by name, folder, branch, prompt"
                     Text="{Binding SessionList.FilterText, UpdateSourceTrigger=PropertyChanged}" />

            <Border DockPanel.Dock="Top" Margin="10,0,10,6" Padding="10,6" CornerRadius="6" Background="#26E5C07B"
                    Visibility="{Binding SessionList.KilledAtRebootCount, Converter={StaticResource VisibleWhen}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Width="22" Height="22" Margin="2,0,-4,0"
                            Content="{StaticResource IconClose}" Command="{Binding DismissKilledSessionsCommand}" ToolTip="Dismiss all" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource PillButtonStyle}" Content="Reopen all" Command="{Binding ReopenKilledSessionsCommand}" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource AttentionBrush}"
                               Text="{Binding SessionList.KilledAtRebootText}"
                               ToolTip="They carry a 'reboot' tag below: double-click one to reopen just that session, or ✕ its tag to dismiss it." />
                </DockPanel>
            </Border>

            <TreeView x:Name="Tree" ItemsSource="{Binding SessionList.Roots}" Foreground="{StaticResource TextPrimaryBrush}">
                <TreeView.ItemContainerStyle>
                    <!-- Folders remember whether they are open; sessions and agents have no such property and stay expanded. -->
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource SessionTreeItemStyle}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay, FallbackValue=True}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="New folder" Command="{Binding SessionList.NewFolderCommand}" />
                    </ContextMenu>
                </TreeView.ContextMenu>
                <TreeView.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding OpenSessionCommand}" CommandParameter="{Binding SelectedItem, ElementName=Tree}" />
                </TreeView.InputBindings>
            </TreeView>
        </DockPanel>
    </Border>
</UserControl>
