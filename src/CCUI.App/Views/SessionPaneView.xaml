<UserControl x:Class="CCUI.App.Views.SessionPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CCUI.Core.ViewModels;assembly=CCUI.Core"
             xmlns:claude="clr-namespace:CCUI.Core.Claude;assembly=CCUI.Core"
             xmlns:term="clr-namespace:CCUI.Terminal.Wpf;assembly=CCUI.Terminal.Wpf"
             xmlns:controls="clr-namespace:CCUI.App.Controls"
             xmlns:views="clr-namespace:CCUI.App.Views"
             x:Name="Root"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SessionPaneViewModel}"
             d:DesignHeight="500" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Border colour: attention (amber) unless focused (accent); focus wins. -->
        <Style x:Key="FrameStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AttentionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=Root}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StateDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Fill" Value="{StaticResource IdleBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Activity}" Value="{x:Static claude:SessionActivity.Working}">
                    <Setter Property="Fill" Value="{StaticResource WorkingBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Activity}" Value="{x:Static claude:SessionActivity.WaitingForUser}">
                    <Setter Property="Fill" Value="{StaticResource WaitingBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource AttentionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasExited}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource ExitedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Margin="3" CornerRadius="8" BorderThickness="{DynamicResource FocusBorderThickness}" Style="{StaticResource FrameStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: state, title, stats, activity meters, actions. -->
            <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" CornerRadius="6,6,0,0" Padding="10,6,6,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <DockPanel>
                            <Ellipse DockPanel.Dock="Left" Margin="0,0,8,0" Style="{StaticResource StateDotStyle}" />
                            <Border DockPanel.Dock="Right" Style="{StaticResource ChipStyle}" Background="#33E5C07B"
                                    Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="{Binding AttentionMessage}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconTextStyle}" FontSize="10" Foreground="{StaticResource AttentionBrush}" Text="{StaticResource IconBell}" />
                                    <TextBlock Margin="4,0,0,0" FontSize="11" Foreground="{StaticResource AttentionBrush}" Text="needs you" />
                                </StackPanel>
                            </Border>
                            <Border DockPanel.Dock="Right" Style="{StaticResource ChipStyle}" ToolTip="{Binding WorkingDirectory}">
                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="{Binding Project, Mode=OneWay}" /><Run Text="{Binding GitBranch, StringFormat=' · ⎇ {0}', Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       ToolTip="{Binding SessionId}" />
                        </DockPanel>

                        <WrapPanel Margin="17,4,0,0" DataContext="{Binding Stats}">
                            <TextBlock Style="{StaticResource StatTextStyle}" Text="{Binding Model}" Foreground="{StaticResource TextPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0" ToolTip="This turn / all turns">
                                <TextBlock x:Name="TurnIcon" Style="{StaticResource IconTextStyle}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="{StaticResource IconStopwatch}" />
                                <TextBlock Style="{StaticResource StatTextStyle}" Margin="4,0,0,0" Text="{Binding TurnTime}" />
                                <TextBlock Style="{StaticResource StatTextStyle}" Margin="4,0,0,0" Foreground="{StaticResource TextMutedBrush}" Text="{Binding TotalTime, StringFormat='Σ {0}'}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource StatTextStyle}" ToolTip="Tokens in (fresh + cache writes) / out / cache reads">
                                <Run Text="↑" Foreground="{StaticResource TextMutedBrush}" /><Run Text="{Binding TokensIn, Mode=OneWay}" />
                                <Run Text=" ↓" Foreground="{StaticResource TextMutedBrush}" /><Run Text="{Binding TokensOut, Mode=OneWay}" />
                                <Run Text=" ⟲" Foreground="{StaticResource TextMutedBrush}" /><Run Text="{Binding CacheRead, Mode=OneWay}" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0" ToolTip="Context window used by the latest request">
                                <ProgressBar Width="46" Style="{StaticResource ThinBarStyle}" Value="{Binding ContextPercent, Mode=OneWay}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource StatTextStyle}" Margin="6,0,0,0" Text="{Binding ContextText}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource StatTextStyle}" Margin="0,0,4,0" ToolTip="Tool calls">
                                <Run Text="{Binding ToolCalls, Mode=OneWay}" /><Run Text=" tools" Foreground="{StaticResource TextMutedBrush}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource StatTextStyle}" Foreground="{StaticResource ErrorBrush}" ToolTip="Failed tool calls"
                                       Text="{Binding ToolErrors, StringFormat='{}{0} failed'}"
                                       Visibility="{Binding ToolErrors, Converter={StaticResource VisibleWhen}}" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- Activity: to the model (prompts, tool results) and from it (text, thinking, tool calls). -->
                    <Grid Grid.Column="1" Width="120" VerticalAlignment="Center" Margin="4,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource IconTextStyle}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Text="{StaticResource IconUp}" ToolTip="Sent" />
                        <controls:LevelMeter Grid.Column="1" Height="6" Margin="5,0,0,0" Level="{Binding SentLevel}"
                                             BarBrush="{StaticResource MeterBrush}" TrackBrush="{StaticResource MeterTrackBrush}" PeakBrush="{StaticResource MeterPeakBrush}" />
                        <TextBlock Grid.Row="1" Margin="0,4,0,0" Style="{StaticResource IconTextStyle}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Text="{StaticResource IconDown}" ToolTip="Received" />
                        <controls:LevelMeter Grid.Row="1" Grid.Column="1" Height="6" Margin="5,4,0,0" Level="{Binding ReceivedLevel}"
                                             BarBrush="{StaticResource MeterBrush}" TrackBrush="{StaticResource MeterTrackBrush}" PeakBrush="{StaticResource MeterPeakBrush}" />
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <ToggleButton Style="{StaticResource IconToggleStyle}" IsChecked="{Binding IsDetailOpen}" Content="{StaticResource IconDetails}" ToolTip="Details" />
                        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding RestartCommand}" Content="{StaticResource IconRefresh}" ToolTip="Resume the session"
                                Visibility="{Binding HasExited, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding CloseCommand}" Content="{StaticResource IconClose}" ToolTip="Close" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Detail view, on top of the terminal; drag the grip to resize. -->
            <views:SessionDetailView Grid.Row="1" DataContext="{Binding Detail}"
                                     Height="{Binding DataContext.DetailHeight, ElementName=Root}"
                                     Visibility="{Binding DataContext.IsDetailOpen, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
            <Thumb Grid.Row="2" Style="{StaticResource SplitterThumbStyle}" DragDelta="OnDetailResize"
                   Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}" />

            <!-- Terminal: scheme background (with opacity), optional image, then the text layer. -->
            <Grid Grid.Row="3">
                <Rectangle Fill="{Binding Background, Source={StaticResource TerminalAppearance}}" RadiusX="6" RadiusY="6" />
                <Image Source="{Binding BackgroundImage, Source={StaticResource TerminalAppearance}}"
                       Opacity="{Binding BackgroundImageOpacity, Source={StaticResource TerminalAppearance}}"
                       Stretch="{Binding BackgroundImageStretch, Source={StaticResource TerminalAppearance}}"
                       HorizontalAlignment="{Binding BackgroundImageHorizontalAlignment, Source={StaticResource TerminalAppearance}}"
                       VerticalAlignment="{Binding BackgroundImageVerticalAlignment, Source={StaticResource TerminalAppearance}}"
                       IsHitTestVisible="False" />
                <term:TerminalControl x:Name="Terminal"
                                      Session="{Binding Terminal}"
                                      FontFamily="{Binding FontFamily, Source={StaticResource TerminalAppearance}}"
                                      FontSize="{Binding FontSize, Source={StaticResource TerminalAppearance}}"
                                      FontWeight="{Binding FontWeight, Source={StaticResource TerminalAppearance}}"
                                      FallbackFontFamilies="{Binding FallbackFontFamilies, Source={StaticResource TerminalAppearance}}"
                                      LineHeight="{Binding LineHeight, Source={StaticResource TerminalAppearance}}"
                                      ColorScheme="{Binding ColorScheme, Source={StaticResource TerminalAppearance}}"
                                      CursorShape="{Binding CursorShape, Source={StaticResource TerminalAppearance}}"
                                      CursorBlink="{Binding CursorBlink, Source={StaticResource TerminalAppearance}}"
                                      IntenseTextStyle="{Binding IntenseTextStyle, Source={StaticResource TerminalAppearance}}"
                                      UseBuiltinGlyphs="{Binding UseBuiltinGlyphs, Source={StaticResource TerminalAppearance}}"
                                      UseColorEmoji="{Binding UseColorEmoji, Source={StaticResource TerminalAppearance}}"
                                      CopyOnSelect="{Binding CopyOnSelect, Source={StaticResource TerminalAppearance}}"
                                      KeyBindings="{Binding KeyBindings, Source={StaticResource TerminalAppearance}}"
                                      Padding="{Binding Padding, Source={StaticResource TerminalAppearance}}"
                                      Background="Transparent" />
            </Grid>

            <!-- Shown once the process has ended. -->
            <Border Grid.Row="4" Background="{StaticResource PanelStrongBrush}" CornerRadius="0,0,6,6" Padding="10,6"
                    Visibility="{Binding HasExited, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PillButtonStyle}" Margin="6,0,0,0" Content="Close" Command="{Binding CloseCommand}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource PillButtonStyle}" Content="Resume" Command="{Binding RestartCommand}" />
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="Session ended" /><Run Text="{Binding ExitCode, StringFormat=' (exit code {0})', Mode=OneWay}" /><Run Text=". It can be resumed with its history." />
                    </TextBlock>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
