{
  // Settings for CCUI. Personal overrides can also go in %LOCALAPPDATA%\CCUI\appsettings.user.json,
  // which is read last and survives updates. Terminal and scheme settings use Windows Terminal's names.
  "Claude": {
    "Command": "claude",
    "Arguments": [],
    "ConfigDirectory": "",
    "FreshEnvironment": true,
    "RemoveEnvironmentVariables": [
      "NO_COLOR",
      "CLAUDECODE",
      "CLAUDE_CODE_CHILD_SESSION",
      "CLAUDE_CODE_ENTRYPOINT",
      "CLAUDE_CODE_SESSION_ID",
      "GIT_TERMINAL_PROMPT",
      "GIT_EDITOR",
      "GCM_INTERACTIVE"
    ],
    "SetEnvironmentVariables": {
      "COLORTERM": "truecolor",
      "TERM_PROGRAM": "CCUI"
    },
    "UseSessionHooks": true,
    "PseudoConsole": "Auto",
    "ContextWindowTokens": 200000,
    "TranscriptPollMilliseconds": 400
  },
  "SessionList": {
    "MaxAgeDays": 14,
    "RefreshSeconds": 5,
    "RebootLookBackHours": 24
  },
  "Terminal": {
    "FontFamily": "Consolas",
    "FontSize": 10,
    "FontWeight": "Normal",
    "FallbackFontFamilies": "Cascadia Mono, Segoe UI Symbol, Segoe UI Emoji, Segoe UI, MS Gothic, Consolas",
    "LineHeight": 1.0,
    "ColorScheme": "Campbell",
    "Schemes": [],
    "CursorShape": "Bar",
    "CursorBlink": true,
    "IntenseTextStyle": "All",
    "UseBuiltinGlyphs": true,
    "UseColorEmoji": true,
    "ScrollbackLines": 10000,
    "CopyOnSelect": false,
    "Opacity": 80,
    "BackgroundImage": "C:\\Users\\tjanichen\\Pictures\\wp3067732-the-expanse-wallpapers.jpg",
    "BackgroundImageOpacity": 0.25,
    "BackgroundImageStretchMode": "UniformToFill",
    "BackgroundImageAlignment": "Center",
    "Padding": "8,4",
    "DefaultColumns": 120,
    "DefaultRows": 30,
    "SendKeys": [
      // Shift+Enter inserts a newline in Claude Code (ESC + CR, like Option+Enter on a Mac).
      {
        "Keys": "Shift+Enter",
        "Text": "\u001b\r"
      }
    ]
  },
  "Appearance": {
    "Backdrop": "Acrylic",
    "WindowTint": "#B0101014",
    "AccentColor": "#D97757",
    "FocusBorderColor": "",
    "FocusBorderThickness": 2,
    "MeterDecayMilliseconds": 400,
    "MeterPeakHoldMilliseconds": 900
  },
  "KeyBindings": {
    "FocusLeft": "Alt+Left",
    "FocusRight": "Alt+Right",
    "FocusUp": "Alt+Up",
    "FocusDown": "Alt+Down",
    "ToggleDetail": "Ctrl+Shift+D",
    "NewSession": "Ctrl+Shift+T",
    "CloseSession": "Ctrl+Shift+W",
    "ToggleSessionList": "Ctrl+Shift+B",
    "FocusSessionList": "Ctrl+Shift+E",
    "TileLayout": "Ctrl+Shift+G"
  },
  "Workspace": {
    "RestoreOnStartup": true,
    "AutoSaveSeconds": 30,
    "Path": "",
    "LaunchStaggerMilliseconds": 800
  },
  "Demo": {
    "Enabled": false,
    "Sessions": 4,
    "Speed": 1.0,
    "Seed": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
