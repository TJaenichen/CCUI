<Project Sdk="Microsoft.NET.Sdk">
  <!-- The plugin contract: what a plugin DLL implements and what CCUI hands it. Plugins reference this project (or
       the CCUI.Plugins.dll next to the installed app) and nothing else of CCUI. Keep it small and stable. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
