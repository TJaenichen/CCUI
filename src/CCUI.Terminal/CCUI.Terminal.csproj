<Project Sdk="Microsoft.NET.Sdk">
  <!-- Terminal emulation engine: VT parser, screen buffer, key encoding, ConPTY connection.
       No UI dependency, so it is testable on any OS (ConPTY itself only runs on Windows). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Wcwidth" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CCUI.Terminal.Tests" />
  </ItemGroup>
</Project>
