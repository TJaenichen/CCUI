<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Pin restore to nuget.org so machine-level feeds don't trip NU1507 under central package management. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
